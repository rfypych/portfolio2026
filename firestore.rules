rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Projects, Services & Testimonials: anyone can read, only authenticated users can write
    match /projects/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /services/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /certifications/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
